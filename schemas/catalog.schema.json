{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weather-report.local/schemas/catalog.schema.json",
  "title": "Catalog",
  "description": "The fixed Region catalog and Variable catalog. Users pick only from these; the engine analyzes only these. Content is ticket #3; this file fixes the shape it loads through.",
  "type": "object",
  "properties": {
    "regions": {
      "type": "array",
      "items": { "$ref": "#/$defs/region" },
      "minItems": 1
    },
    "variables": {
      "type": "array",
      "items": { "$ref": "#/$defs/variable" },
      "minItems": 1
    },
    "method_citation": {
      "description": "Citation text for the method paper, shown under \"How do we know?\".",
      "type": "string",
      "minLength": 1
    },
    "engine_version": { "$ref": "common.schema.json#/$defs/engineVersion" }
  },
  "required": ["regions", "variables", "method_citation", "engine_version"],
  "additionalProperties": false,
  "$defs": {
    "region": {
      "type": "object",
      "properties": {
        "region_id": { "$ref": "common.schema.json#/$defs/regionId" },
        "name": { "type": "string", "minLength": 1 },
        "description": {
          "description": "One line a high school student can read.",
          "type": "string",
          "minLength": 1
        },
        "bbox": { "$ref": "#/$defs/bbox" },
        "variable_ids": {
          "description": "The Variables that apply to this Region. Land-only Variables are not listed for ocean Regions.",
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/variableId" },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": ["region_id", "name", "description", "bbox", "variable_ids"],
      "additionalProperties": false
    },
    "bbox": {
      "description": "Bounding box in degrees, west/east in [-180, 180] and south/north in [-90, 90].",
      "type": "object",
      "properties": {
        "west": { "type": "number", "minimum": -180, "maximum": 180 },
        "east": { "type": "number", "minimum": -180, "maximum": 180 },
        "south": { "type": "number", "minimum": -90, "maximum": 90 },
        "north": { "type": "number", "minimum": -90, "maximum": 90 }
      },
      "required": ["west", "east", "south", "north"],
      "additionalProperties": false
    },
    "variable": {
      "type": "object",
      "properties": {
        "variable_id": { "$ref": "common.schema.json#/$defs/variableId" },
        "name": { "type": "string", "minLength": 1 },
        "units": { "type": "string", "minLength": 1 },
        "definition": {
          "description": "Plain-language definition a high school student can read.",
          "type": "string",
          "minLength": 1
        },
        "source": { "$ref": "common.schema.json#/$defs/source" },
        "land_only": {
          "description": "True when the Variable needs a land mask, which also brings the land-fraction gate into play (BS-003).",
          "type": "boolean"
        },
        "possible_causes": {
          "description": "Hand-written causes the Reason step offers, each labeled as context from scientists rather than a result of the data.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": { "type": "string", "minLength": 1 },
              "kind": { "type": "string", "const": "context" }
            },
            "required": ["text", "kind"],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": ["variable_id", "name", "units", "definition", "source", "land_only", "possible_causes"],
      "additionalProperties": false
    }
  }
}
