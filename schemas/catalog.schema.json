{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weather-report.local/schemas/catalog.schema.json",
  "title": "Catalog",
  "description": "The fixed Region catalog and Variable catalog. Users pick only from these; the engine analyzes only these. A Variable is defined in variable.schema.json so its definition can be reused outside the catalog.",
  "type": "object",
  "properties": {
    "regions": {
      "type": "array",
      "items": { "$ref": "#/$defs/region" },
      "minItems": 1
    },
    "variables": {
      "type": "array",
      "items": { "$ref": "variable.schema.json" },
      "minItems": 1
    },
    "method_citation": {
      "description": "Citation text for the method paper, shown under \"How do we know?\".",
      "type": "string",
      "minLength": 1
    },
    "engine_version": { "$ref": "common.schema.json#/$defs/engineVersion" }
  },
  "required": ["regions", "variables", "method_citation", "engine_version"],
  "additionalProperties": false,
  "$defs": {
    "region": {
      "type": "object",
      "properties": {
        "region_id": { "$ref": "common.schema.json#/$defs/regionId" },
        "name": { "type": "string", "minLength": 1 },
        "description": {
          "description": "One line a high school student can read.",
          "type": "string",
          "minLength": 1
        },
        "bbox": { "$ref": "#/$defs/bbox" },
        "variable_ids": {
          "description": "The Variables that apply to this Region. Land-only Variables are not listed for ocean Regions.",
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/variableId" },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": ["region_id", "name", "description", "bbox", "variable_ids"],
      "additionalProperties": false
    },
    "bbox": {
      "description": "Bounding box in degrees, west/east in [-180, 180] and south/north in [-90, 90].",
      "type": "object",
      "properties": {
        "west": { "type": "number", "minimum": -180, "maximum": 180 },
        "east": { "type": "number", "minimum": -180, "maximum": 180 },
        "south": { "type": "number", "minimum": -90, "maximum": 90 },
        "north": { "type": "number", "minimum": -90, "maximum": 90 }
      },
      "required": ["west", "east", "south", "north"],
      "additionalProperties": false
    }
  }
}
