{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weather-report.local/schemas/series.schema.json",
  "title": "Series",
  "description": "One monthly, area-weighted time series for a Region-Variable pair (DS-001).",
  "type": "object",
  "properties": {
    "region_id": { "$ref": "common.schema.json#/$defs/regionId" },
    "variable_id": { "$ref": "common.schema.json#/$defs/variableId" },
    "period": { "$ref": "common.schema.json#/$defs/period" },
    "units": { "type": "string" },
    "values": {
      "description": "One entry per calendar month from period.start to period.end inclusive, so index i is the month i after period.start. A missing month is null rather than omitted, which keeps the index aligned with the calendar.",
      "type": "array",
      "items": { "type": ["number", "null"] },
      "minItems": 1
    },
    "quality": { "$ref": "#/$defs/quality" },
    "source": { "$ref": "common.schema.json#/$defs/source" },
    "engine_version": { "$ref": "common.schema.json#/$defs/engineVersion" }
  },
  "required": ["region_id", "variable_id", "period", "units", "values", "quality", "source", "engine_version"],
  "additionalProperties": false,
  "$defs": {
    "quality": {
      "description": "Result of the quality gate (BS-003).",
      "type": "object",
      "properties": {
        "included": {
          "description": "False when the gate excludes this series from every Candidate Discovery.",
          "type": "boolean"
        },
        "missing_fraction": {
          "description": "Share of months in the period with no value. Above 0.2 the series is excluded.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "valid_land_fraction": {
          "description": "Share of the Region's cells that are valid land, for Variables with a land mask. Below 0.5 the series is excluded. Null for Variables without a land mask.",
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "exclusions": {
          "description": "Why the gate excluded the series. Empty when it was kept.",
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["too_many_missing_months", "insufficient_land_fraction"]
          },
          "uniqueItems": true
        }
      },
      "required": ["included", "missing_fraction", "valid_land_fraction", "exclusions"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "exclusions": { "minItems": 1 } },
            "required": ["exclusions"]
          },
          "then": {
            "properties": { "included": { "const": false } }
          }
        }
      ]
    }
  }
}
