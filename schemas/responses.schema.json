{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weather-report.local/schemas/responses.schema.json",
  "title": "HTTP responses",
  "description": "What the API returns (BS-009). Every success body is a resource under \"data\" plus a \"notice\", which is set when live acquisition fails. Series provenance distinguishes live, cached and preloaded data.",
  "$defs": {
    "catalogResponse": {
      "type": "object",
      "properties": {
        "data": { "$ref": "catalog.schema.json" },
        "notice": { "$ref": "common.schema.json#/$defs/notice" }
      },
      "required": ["data", "notice"],
      "additionalProperties": false
    },
    "availableSeriesResponse": {
      "description": "The Region-Variable series the service holds, without their values.",
      "type": "object",
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "region_id": { "$ref": "common.schema.json#/$defs/regionId" },
              "variable_id": { "$ref": "common.schema.json#/$defs/variableId" },
              "period": { "$ref": "common.schema.json#/$defs/period" }
            },
            "required": ["region_id", "variable_id", "period"],
            "additionalProperties": false
          }
        },
        "notice": { "$ref": "common.schema.json#/$defs/notice" }
      },
      "required": ["data", "notice"],
      "additionalProperties": false
    },
    "seriesResponse": {
      "type": "object",
      "properties": {
        "data": { "$ref": "series.schema.json" },
        "provenance": { "type": "string", "enum": ["live", "cache", "preloaded"] },
        "notice": { "$ref": "common.schema.json#/$defs/notice" }
      },
      "required": ["data", "notice"],
      "additionalProperties": false
    },
    "discoveryResponse": {
      "type": "object",
      "properties": {
        "data": { "$ref": "discovery.schema.json" },
        "notice": { "$ref": "common.schema.json#/$defs/notice" }
      },
      "required": ["data", "notice"],
      "additionalProperties": false
    },
    "discoveryListResponse": {
      "type": "object",
      "properties": {
        "data": {
          "type": "array",
          "items": { "$ref": "discovery.schema.json" }
        },
        "notice": { "$ref": "common.schema.json#/$defs/notice" }
      },
      "required": ["data", "notice"],
      "additionalProperties": false
    },
    "comparisonResponse": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "properties": {
            "trends": {
              "type": "array",
              "items": {
                "$ref": "trend.schema.json"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "series": {
              "type": "array",
              "items": {
                "$ref": "series.schema.json"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "trends",
            "series"
          ],
          "additionalProperties": false
        },
        "notice": {
          "$ref": "common.schema.json#/$defs/notice"
        }
      },
      "required": [
        "data",
        "notice"
      ],
      "additionalProperties": false
    },
    "exploreSeriesResponse": {
      "description": "Explore My World (#75): one catalog Region's Series for one to five Variables, built with one Aggregation and one Time step over one period. Each Series covers exactly the requested period, and its quality is the Quality gate's verdict on that period.",
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "properties": {
            "region_id": { "$ref": "common.schema.json#/$defs/regionId" },
            "aggregation": {
              "type": "string",
              "enum": [
                "mean",
                "median",
                "minimum",
                "maximum",
                "root_mean_square",
                "standard_deviation",
                "mean_absolute_value"
              ]
            },
            "time_step": { "type": "string", "enum": ["3-hourly", "daily", "monthly"] },
            "period": { "$ref": "common.schema.json#/$defs/period" },
            "series": {
              "type": "array",
              "items": { "$ref": "series.schema.json" },
              "minItems": 1,
              "maxItems": 5
            }
          },
          "required": ["region_id", "aggregation", "time_step", "period", "series"],
          "additionalProperties": false
        },
        "provenance": { "type": "string", "enum": ["live", "cache", "preloaded"] },
        "notice": { "$ref": "common.schema.json#/$defs/notice" }
      },
      "required": ["data", "notice", "provenance"],
      "additionalProperties": false
    },
    "errorResponse": {
      "description": "Returned with a 4xx or 5xx status. A Region or Variable outside the catalog is rejected with 422 and code region_not_in_catalog or variable_not_in_catalog; a Variable that does not apply to the Region is variable_not_available_for_region. Explore My World refuses a malformed view with 422 (invalid_variable_count, duplicate_variable, invalid_aggregation, invalid_time_step, invalid_period, period_out_of_range, period_too_long) and answers 501 not_available_yet for Series that need data fetched from NASA.",
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "region_not_in_catalog",
                "variable_not_in_catalog",
                "variable_not_available_for_region",
                "result_not_available",
                "invalid_period",
                "live_data_unavailable",
                "no_discovery_left_in_session",
                "invalid_variable_count",
                "duplicate_variable",
                "invalid_aggregation",
                "invalid_time_step",
                "period_out_of_range",
                "period_too_long",
                "not_available_yet"
              ]
            },
            "message": { "type": "string", "minLength": 1 }
          },
          "required": ["code", "message"],
          "additionalProperties": false
        }
      },
      "required": ["error"],
      "additionalProperties": false
    }
  }
}
