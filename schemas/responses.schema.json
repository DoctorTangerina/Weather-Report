{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weather-report.local/schemas/responses.schema.json",
  "title": "HTTP responses",
  "description": "What the API returns (BS-009). Every success body is a resource under \"data\" plus a \"notice\", which is set when live acquisition fails. Series provenance distinguishes live, cached and preloaded data.",
  "$defs": {
    "catalogResponse": {
      "type": "object",
      "properties": {
        "data": { "$ref": "catalog.schema.json" },
        "notice": { "$ref": "common.schema.json#/$defs/notice" }
      },
      "required": ["data", "notice"],
      "additionalProperties": false
    },
    "availableSeriesResponse": {
      "description": "The Region-Variable series the service holds, without their values.",
      "type": "object",
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "region_id": { "$ref": "common.schema.json#/$defs/regionId" },
              "variable_id": { "$ref": "common.schema.json#/$defs/variableId" },
              "period": { "$ref": "common.schema.json#/$defs/period" }
            },
            "required": ["region_id", "variable_id", "period"],
            "additionalProperties": false
          }
        },
        "notice": { "$ref": "common.schema.json#/$defs/notice" }
      },
      "required": ["data", "notice"],
      "additionalProperties": false
    },
    "seriesResponse": {
      "type": "object",
      "properties": {
        "data": { "$ref": "series.schema.json" },
        "provenance": { "type": "string", "enum": ["live", "cache", "preloaded"] },
        "notice": { "$ref": "common.schema.json#/$defs/notice" }
      },
      "required": ["data", "notice"],
      "additionalProperties": false
    },
    "discoveryResponse": {
      "type": "object",
      "properties": {
        "data": { "$ref": "discovery.schema.json" },
        "notice": { "$ref": "common.schema.json#/$defs/notice" }
      },
      "required": ["data", "notice"],
      "additionalProperties": false
    },
    "discoveryListResponse": {
      "type": "object",
      "properties": {
        "data": {
          "type": "array",
          "items": { "$ref": "discovery.schema.json" }
        },
        "notice": { "$ref": "common.schema.json#/$defs/notice" }
      },
      "required": ["data", "notice"],
      "additionalProperties": false
    },
    "comparisonResponse": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "properties": {
            "trends": {
              "type": "array",
              "items": {
                "$ref": "trend.schema.json"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "series": {
              "type": "array",
              "items": {
                "$ref": "series.schema.json"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "trends",
            "series"
          ],
          "additionalProperties": false
        },
        "notice": {
          "$ref": "common.schema.json#/$defs/notice"
        }
      },
      "required": [
        "data",
        "notice"
      ],
      "additionalProperties": false
    },
    "exploreSeriesResponse": {
      "description": "Explore My World (#75, #79): the Series of one catalog Region or one Selected area for one to five Variables, built with one Aggregation and one Time step over one period. Each Series covers exactly the requested period, and its quality is the Quality gate's verdict on that period.",
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "properties": {
            "region_id": { "$ref": "common.schema.json#/$defs/regionId" },
            "area": { "$ref": "common.schema.json#/$defs/selectedArea" },
            "aggregation": {
              "type": "string",
              "enum": [
                "mean",
                "median",
                "minimum",
                "maximum",
                "root_mean_square",
                "standard_deviation",
                "mean_absolute_value"
              ]
            },
            "time_step": { "type": "string", "enum": ["3-hourly", "daily", "monthly"] },
            "period": { "$ref": "common.schema.json#/$defs/period" },
            "series": {
              "type": "array",
              "items": {
                "oneOf": [
                  { "$ref": "series.schema.json" },
                  { "$ref": "series.schema.json#/$defs/areaSeries" }
                ]
              },
              "minItems": 1,
              "maxItems": 5
            }
          },
          "required": ["aggregation", "time_step", "period", "series"],
          "oneOf": [{ "required": ["region_id"] }, { "required": ["area"] }],
          "additionalProperties": false
        },
        "provenance": { "type": "string", "enum": ["live", "cache", "preloaded"] },
        "notice": { "$ref": "common.schema.json#/$defs/notice" }
      },
      "required": ["data", "notice", "provenance"],
      "additionalProperties": false
    },
    "exploreOptionsResponse": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "properties": {
            "latest_month": {
              "type": "string",
              "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
            },
            "area_variable_ids": {
              "description": "The Variables a Selected area can have: those NASA data can be fetched for on demand.",
              "type": "array",
              "items": { "$ref": "common.schema.json#/$defs/variableId" },
              "uniqueItems": true
            }
          },
          "required": [
            "latest_month",
            "area_variable_ids"
          ],
          "additionalProperties": false
        },
        "notice": {
          "$ref": "common.schema.json#/$defs/notice"
        }
      },
      "required": [
        "data",
        "notice"
      ],
      "additionalProperties": false
    },
    "exploreJobResponse": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "properties": {
            "job": {
              "$ref": "#/$defs/exploreJob"
            }
          },
          "required": [
            "job"
          ],
          "additionalProperties": false
        },
        "notice": {
          "$ref": "common.schema.json#/$defs/notice"
        }
      },
      "required": [
        "data",
        "notice"
      ],
      "additionalProperties": false
    },
    "exploreJob": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^/api/explore/jobs/[a-f0-9]+$"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed"
          ]
        },
        "progress": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "result": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/exploreSeriesResponse/properties/data"
            }
          ]
        },
        "error": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "code": {
                  "const": "acquisition_failed"
                },
                "message": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "code",
                "message"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "id",
        "url",
        "status",
        "progress",
        "result",
        "error"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "succeeded"
              }
            }
          },
          "then": {
            "properties": {
              "result": {
                "type": "object"
              },
              "progress": {
                "const": 100
              },
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "type": "object"
              },
              "result": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "queued",
                  "running"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "result": {
                "type": "null"
              },
              "error": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "errorResponse": {
      "description": "Returned with a 4xx or 5xx status. A Region or Variable outside the catalog is rejected with 422 and code region_not_in_catalog or variable_not_in_catalog; a Variable that does not apply to the Region is variable_not_available_for_region. Explore My World refuses a malformed view with 422 (invalid_variable_count, duplicate_variable, invalid_aggregation, invalid_time_step, invalid_period, period_out_of_range, period_too_long) and answers 501 not_available_yet for Aggregations or Time steps not yet implemented; unknown job references return 404 job_not_found.",
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "region_not_in_catalog",
                "variable_not_in_catalog",
                "variable_not_available_for_region",
                "result_not_available",
                "invalid_period",
                "live_data_unavailable",
                "no_discovery_left_in_session",
                "invalid_variable_count",
                "duplicate_variable",
                "invalid_aggregation",
                "invalid_time_step",
                "period_out_of_range",
                "period_too_long",
                "not_available_yet",
                "invalid_area",
                "variable_not_available_for_area",
                "job_not_found"
              ]
            },
            "message": { "type": "string", "minLength": 1 }
          },
          "required": ["code", "message"],
          "additionalProperties": false
        }
      },
      "required": ["error"],
      "additionalProperties": false
    }
  }
}
