# Copy to .env (ignored by Git) and fill in. `python scripts/run_app.py` passes
# every value here to the API; values exported in your shell win.

# NASA Earthdata login token, used only by the API for live data (periods past
# the seed set, Selected areas, daily and 3-hourly Time steps, Field maps).
# Without it the app still runs on the committed seed set. Create one at
# https://urs.earthdata.nasa.gov/ under "Generate Token".
EARTHDATA_TOKEN=

# Everything below is optional; the defaults are shown.
# WEATHER_REPORT_DATA_DIR=data/seed
# WEATHER_REPORT_CATALOG=data/catalog.json
# WEATHER_REPORT_CACHE_DIR=.scratch/results-cache
# WEATHER_REPORT_LIVE_TIMEOUT_SECONDS=120
# WEATHER_REPORT_ACQUISITION_CONFIG=data/data_gathering/config.json
# Origins allowed to call the API from another host, comma-separated. Only
# needed when deployed (the Azure static site); locally the Vite proxy keeps
# one origin.
# WEATHER_REPORT_ALLOWED_ORIGINS=https://jolly-island-0d3a3b610.5.azurestaticapps.net
# Last month the UI offers, YYYY-MM; defaults to the last complete UTC month.
# WEATHER_REPORT_LATEST_MONTH=
